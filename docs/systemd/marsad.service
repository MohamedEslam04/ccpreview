[Unit]
Description=Marsad (Claude Code session viewer)
Requires=marsad.socket
After=marsad.socket

[Service]
Type=simple
# Use an absolute path to node and to the marsad script. See README.md in this folder.
ExecStart=/usr/bin/env marsad --no-open
# Alternative without a global install:
# ExecStart=/usr/bin/env npx --yes marsad --no-open
